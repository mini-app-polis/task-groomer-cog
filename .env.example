# task-groomer-cog — the names this cog reads. Names only: the values live
# in Doppler (mini-app-polis-ecosystem / dev locally) and, for the Lambda
# worker, in SSM. Run under `doppler run -- …`; do not copy this to .env —
# nothing reads it.
#
# Uncommented names are required. Commented names are optional: the code
# has a default.

# ─────────────────────────────────────────────────────────────────────
# Required: the model
# ─────────────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Required: upstream API (spend, run costs, proposals, run reports)
# ─────────────────────────────────────────────────────────────────────

# This cog's named key. There is no fallback.
KAIANO_API_BASE_URL=
TASK_GROOMER_COG_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────────────

# Read access to the fleet's repositories. Every one is public, but
# without a token GitHub allows 60 requests an hour.
# GITHUB_TOKEN=

# The caps. See README.md.
# GROOMER_MODEL=claude-sonnet-5-5
# GROOMER_MAX_ROUNDS=8
# GROOMER_MAX_INPUT_TOKENS=150000
# GROOMER_MAX_OUTPUT_TOKENS=16384
# GROOMER_MONTHLY_CAP_USD=20

# true to let a run split a task into children. See README.md.
# GROOMER_SPLIT=

# Where the fleet's repositories are listed. Defaults to
# ecosystem-standards' ecosystem.yaml on main.
# ECOSYSTEM_YAML_URL=

# Local runs only (python -m task_groomer_cog): the board the task is read
# from. Read, never written.
# ASANA_ACCESS_TOKEN=
# ASANA_INBOX_PROJECT_ID=

# SENTRY_DSN_COGS=
# LOGGING_LEVEL=INFO
# ENVIRONMENT=development

# Base URL of api-kaianolevine-com outside production.
KAIANO_API_BASE_URL_DEV=
